# Saarthi Environment Configuration Example
# Copy this file to '.env' and fill in your values

# Server Settings
PORT=8000
HOST=127.0.0.1

# Agent Core Settings
# Options: mock, ollama
APP_NAME=Saarthi
MODEL_PROVIDER=mock
MODEL_NAME=mock-model

# Ollama / Local Provider settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=512
OLLAMA_THINK=False

# Optional API configuration for cloud endpoints
API_BASE_URL=

# Workspace directories & database
DATABASE_PATH=data/database/saarthi.db
SAARTHI_DATA_DIR=data

# Tool System Settings
TOOL_ENABLED=True
TOOL_ROOT_PATH=.
MAX_TOOL_ITERATIONS=8
MAX_TOOL_OUTPUT_CHARS=12000
TERMINAL_TIMEOUT_SECONDS=30
TRUSTED_PATHS=.;%USERPROFILE%\OneDrive\Desktop;%USERPROFILE%\Downloads;%USERPROFILE%\Documents

