# Saarthi Production Environment Configuration Example

ENVIRONMENT=production
APP_NAME=Saarthi
PORT=8000
HOST=0.0.0.0

# Canonical Domains
PRODUCTION_DOMAIN=saarthi.trovanetech.com
ADMIN_DOMAIN=admin.saarthi.trovanetech.com
API_DOMAIN=api.saarthi.trovanetech.com

# Database (SQLite default or PostgreSQL URI)
DATABASE_PATH=data/database/saarthi_prod.db
# POSTGRES_URI=postgresql://saarthi_user:secure_password@localhost:5432/saarthi_prod
SAARTHI_DATA_DIR=data

# AI Provider Settings
MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5:14b-instruct-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048

# Security & Credentials (MUST BE SET TO SECURE RANDOM STRINGS)
JWT_SECRET=change_me_to_a_secure_64char_random_production_secret
ADMIN_SECRET_KEY=change_me_to_a_secure_64char_production_admin_key
SESSION_EXPIRE_MINUTES=720

# Payment & Billing Architecture (LIVE PAYMENTS DISABLED UNTIL FUNDING)
PAYMENT_PROVIDER=razorpay
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_production_placeholder
RAZORPAY_KEY_SECRET=rzp_test_production_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_placeholder

# Feature Flags
FEATURE_VOICE=True
FEATURE_ADVANCED_VOICE=True
FEATURE_AGENTS=True
FEATURE_AUTOMATION=True
FEATURE_RESEARCH=True
FEATURE_MULTIMODAL=True
FEATURE_TEAMS=True
FEATURE_BILLING=False
