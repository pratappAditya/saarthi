# Saarthi Staging Environment Configuration Example

ENVIRONMENT=staging
APP_NAME=Saarthi Staging
PORT=8000
HOST=0.0.0.0

# Domains
PRODUCTION_DOMAIN=saarthi.trovanetech.com
ADMIN_DOMAIN=admin.saarthi.trovanetech.com
API_DOMAIN=api.saarthi.trovanetech.com

# Database
DATABASE_PATH=data/database/saarthi_staging.db
SAARTHI_DATA_DIR=data

# AI Provider Settings
MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5:7b-instruct-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=1024

# Secrets & Security
JWT_SECRET=change_me_to_a_secure_random_staging_secret_key_32bytes
ADMIN_SECRET_KEY=change_me_to_staging_admin_secret_key
SESSION_EXPIRE_MINUTES=1440

# Payment & Billing (DISABLED / TEST MODE ONLY)
PAYMENT_PROVIDER=razorpay
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_staging_placeholder
RAZORPAY_KEY_SECRET=rzp_test_staging_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_placeholder

# Feature Flags
FEATURE_VOICE=True
FEATURE_ADVANCED_VOICE=True
FEATURE_AGENTS=True
FEATURE_AUTOMATION=True
FEATURE_RESEARCH=True
FEATURE_MULTIMODAL=True
FEATURE_TEAMS=True
FEATURE_BILLING=False
