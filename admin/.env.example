# Saarthi Admin Control Plane Environment Configuration
# NOTE: Never store database credentials, provider secrets, or master admin keys in VITE_* variables!

# Base URL pointing to Saarthi backend API (empty string defaults to same-origin / proxy)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Deployment environment label ('development', 'staging', 'production')
VITE_APP_ENV=development
